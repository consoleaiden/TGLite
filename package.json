{
  "name": "TGLite",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:shims && npm run verify:transport && npm run verify:faketls",
    "verify:shims": "node scripts/verify-shims.js",
    "verify:transport": "node scripts/verify-transport.js",
    "verify:faketls": "node scripts/verify-faketls-e2e.js",
    "config": "node scripts/gen-config.js",
    "apk": "cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@noble/hashes": "1.4.0",
    "@react-native-async-storage/async-storage": "1.24.0",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "buffer": "6.0.3",
    "path-browserify": "1.0.1",
    "react": "18.3.1",
    "react-native": "0.75.5",
    "react-native-document-picker": "^9.3.1",
    "react-native-get-random-values": "1.11.0",
    "react-native-image-picker": "^7.1.2",
    "react-native-safe-area-context": "4.11.1",
    "react-native-screens": "3.34.0",
    "react-native-tcp-socket": "6.4.3",
    "telegram": "2.26.22",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.75.5",
    "@react-native/eslint-config": "0.75.5",
    "@react-native/metro-config": "0.75.5",
    "@react-native/typescript-config": "0.75.5",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
